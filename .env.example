# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# Used by worker/worker.py only. The browser app uses web/js/config.js instead.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# SERVICE ROLE key (Supabase dashboard -> Project Settings -> API).
# Bypasses all row-level security. Never put this in web/ or in a commit.
SUPABASE_SERVICE_KEY=

# Seconds between polls when running the worker in continuous local mode.
WORKER_POLL_INTERVAL=15

# Delete the raw video from storage after a successful stitch (protects the 1 GB free tier).
WORKER_DELETE_SOURCE=true
