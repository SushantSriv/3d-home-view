# Copy to .env and fill in. .env is gitignored -- never commit real keys.
# Used by worker/worker.py only. The browser app uses web/js/config.js instead.

# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# SERVICE ROLE key (Supabase dashboard -> Project Settings -> API).
# Bypasses all row-level security. Never put this in web/ or in a commit.
SUPABASE_SERVICE_KEY=

# Seconds between polls when running the worker in continuous local mode.
WORKER_POLL_INTERVAL=15

# Delete the raw video from storage after a successful stitch.
# Off while the pipeline is being tuned: keeping the source is the only way to
# re-stitch a room with different settings. Turn it on once quality is settled,
# or run scripts/prune_videos.ps1 when storage gets tight.
WORKER_DELETE_SOURCE=false
